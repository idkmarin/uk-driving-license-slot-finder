{
  "manifest_version": 3,
  "name": "UK Driving License Slot Finder",
  "version": "1.0.0",
  "description": "Automatically search and monitor available UK driving license test booking slots across multiple test centres",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.gov.uk/*",
    "https://www.theory-test.service.gov.uk/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Driving License Slot Finder"
  }
}
